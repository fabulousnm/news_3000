  "variant_anomaly_policy": {
    "clean": {
      "tamper_types": [],
      "anomaly_category": [],
      "changed_field_count": 0,
      "rule_failure_count": 0,
      "single_image_detectable": null
    },
    "subtle": {
      "tamper_types_min": 1,
      "anomaly_category_min": 1,
      "single_image_detectable": true,
      "note": "改动局部，单看该图即可发现不一致。"
    },
    "strong": {
      "tamper_types_min": 2,
      "anomaly_category_min": 2,
      "single_image_detectable": true,
      "note": "存在多处不一致或明显冲突。"
    }
  }
