  "rule_violation_types": {
    "note": "与内容类型并行记录，描述违反了哪一条一致性规则。anomaly_category 取值为下列键名。",
    "date_order": {"name_zh": "日期先后矛盾", "basis": "dataset-designed inconsistency"},
    "number_relation": {"name_zh": "数值关系矛盾", "basis": "dataset-designed inconsistency"},
    "set_relation": {"name_zh": "集合与范围矛盾", "basis": "dataset-designed inconsistency"},
    "unit_consistency": {"name_zh": "单位与量级不符", "basis": "dataset-designed inconsistency"},
    "attribution_chain": {"name_zh": "信息链断裂或循环", "basis": "dataset-designed inconsistency"},
    "subject_agreement": {"name_zh": "主语与所述行为不符", "basis": "dataset-designed inconsistency"},
    "quantity_sum": {"name_zh": "分项与合计不等", "basis": "dataset-designed inconsistency"},
    "temporal_window": {"name_zh": "时间落于不合理区间", "basis": "dataset-designed inconsistency"},
